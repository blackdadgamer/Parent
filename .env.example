# Everest AI — Parent App Environment Variables
# Copy this file to .env.local and fill in real values.

# App URLs
NEXT_PUBLIC_APP_URL=https://everestai.cloud
NEXT_PUBLIC_API_URL=https://api.everestai.cloud

# Supabase (must match other Everest AI apps for SSO to work)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
